# Copy this file to .env and fill in the values.
# .env is gitignored - never commit real keys.
#
# RULE: NEXT_PUBLIC_* is shipped to the browser. Never put a key there.

# ---------------------------------------------------------------
# App (public - safe in browser)
# ---------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=AirMitra
NEXT_PUBLIC_APP_TAGLINE=Household Air Coach
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_ENABLE_GENAI=true
NEXT_PUBLIC_ENABLE_TRAVEL=true
NEXT_PUBLIC_ENABLE_REPORTS=true

# ---------------------------------------------------------------
# AI - server-side only
# ---------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACK=gemini-flash-lite-latest
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=400

# ---------------------------------------------------------------
# India data - server-side only
# ---------------------------------------------------------------
# data.gov.in -> CPCB real-time AQI
DATA_GOV_API_KEY=

# XKDR India Air Quality DB
XKDR_API_KEY=

# OpenAQ (optional fallback - skip if signup fails)
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3

# ---------------------------------------------------------------
# Forecast + weather - no key required
# ---------------------------------------------------------------
OPEN_METEO_AQ_BASE_URL=https://air-quality-api.open-meteo.com/v1
OPEN_METEO_WEATHER_BASE_URL=https://api.open-meteo.com/v1

# ---------------------------------------------------------------
# Optional providers
# ---------------------------------------------------------------
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------
# Cache + limits
# ---------------------------------------------------------------
AQI_CACHE_TTL_SECONDS=900
LLM_CACHE_TTL_SECONDS=3600
LLM_TIMEOUT_MS=8000

# ---------------------------------------------------------------
# Demo / development
# ---------------------------------------------------------------
DEMO_MODE=false
